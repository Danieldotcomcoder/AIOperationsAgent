# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Every value below is read exactly once, by opspilot.core.config.Settings.

# ---------------------------------------------------------------- environment
APP_ENV=development                 # development | test | staging | production
APP_NAME=opspilot
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json | console
API_BASE_URL=http://127.0.0.1:8000
# CORS allowlist: exact origins, comma-separated, never a wildcard.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------------- datastores
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_DB=opspilot
# 127.0.0.1, not localhost: on Windows 'localhost' resolves to ::1 first and the
# Docker port proxy stalls there for ~30s before falling back to IPv4.
# Host-side ports. Deliberately not 5432/6379: a dev machine often already runs
# those, and Docker binds the conflict silently. Containers still talk on 5432/6379
# over the compose network (docker-compose.yml overrides these URLs for them).
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@127.0.0.1:55432/opspilot
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
REDIS_URL=redis://127.0.0.1:56379/0
CELERY_BROKER_URL=redis://127.0.0.1:56379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:56379/2

# ------------------------------------------------------------------- identity
AUTH_MODE=dev                       # dev | auth0   (ADR 0008)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ISSUER=
# Dev issuer only. Ignored — and refused — unless APP_ENV is development/test.
DEV_AUTH_SIGNING_KEY_PATH=.data/dev-auth-key.pem
DEV_AUTH_TOKEN_TTL_SECONDS=28800

# ---------------------------------------------------------------------- model
LLM_PROVIDER=fake                   # fake | openai | anthropic | openrouter
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# To use free chat inference: LLM_PROVIDER=openrouter, LLM_MODEL=openrouter/free.
# Or pin a model's :free variant with tools and JSON response support.
OPENROUTER_FREE_ONLY=true
# Paid routes require FREE_ONLY=false and BOTH explicit per-million token prices:
# OPENROUTER_INPUT_USD_PER_MILLION=...
# OPENROUTER_OUTPUT_USD_PER_MILLION=...
EMBEDDING_PROVIDER=fake             # fake | openai | openrouter
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# fake = offline word-hash vectors for development, NOT semantic retrieval.
# openai = paid text-embedding-3-small; requires a separate OPENAI_API_KEY.
# openrouter = liquid/lfm-2.5-embedding-350m:free, using OPENROUTER_API_KEY.
# Liquid native 1024 dimensions are zero-padded to storage width 1536 (cosine preserved).
# Keep EMBEDDING_DIM=1536 and CHUNK_TARGET_TOKENS<=500; inputs over 500 bytes fail closed.

# ------------------------------------------------------------- agent bounds
# These are hard limits, not suggestions. Retries count toward every one of them.
RUN_MAX_TURNS=3
RUN_MAX_TOOL_CALLS=6
RUN_DEADLINE_SECONDS=90
PROVIDER_CALL_DEADLINE_SECONDS=25
RUN_MAX_INPUT_TOKENS=20000
RUN_MAX_OUTPUT_TOKENS=3000
RETRIEVAL_CANDIDATES=8
RETRIEVAL_TOP_K=5
RETRIEVAL_TOKEN_BUDGET=2500
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# ----------------------------------------------------------------- cost guard
BUDGET_MONTHLY_USD=15
BUDGET_DAILY_USD=2
BUDGET_PER_USER_DAILY_RUNS=50
# Master kill switch for every write path. Flip to false during an incident.
FEATURE_WRITES_ENABLED=true
FEATURE_AGENT_ENABLED=true

# ------------------------------------------------------------------ lifecycle
PROPOSAL_EXPIRY_HOURS=24
TRACE_RETENTION_DAYS=14
AUDIT_RETENTION_DAYS=90

# -------------------------------------------------------------- business date
# The day "overdue" and "effective" are evaluated on, for the inbox and the agent alike.
# The synthetic dataset is frozen at 2026-09-12 (data/seed/generate.py), so pin it there.
# Leave blank to use today's UTC date. Expiry, retention and budgets always use real time.
OPERATIONS_AS_OF=2026-09-12

# -------------------------------------------------- simulated ERP boundary
# The internal operations API is ours; it is called with a service credential so
# that the boundary is real code, not an import. 127.0.0.1, not localhost: on Windows
# localhost tries ::1 first and each refused connection costs about two seconds.
OPS_API_BASE_URL=http://127.0.0.1:8000/ops
OPS_API_SERVICE_TOKEN=change-me-locally
OPS_API_TIMEOUT_SECONDS=10

# --------------------------------------------------------------------- deploy
SITE_DOMAIN=localhost
ACME_EMAIL=
